local function hasAnyATMAlive()
    local atms = workspace:FindFirstChild("ATMs")
    if not atms then return false end
    for _, atm in ipairs(atms:GetChildren()) do
        if atm:IsA("Model") and (atm:GetAttribute("health") or 0) ~= 0 then
            return true
        end
    end
    return false
end

local function hasBankCash()
    local bank = workspace:FindFirstChild("BankRobbery")
    if not bank then return false end
    local cashFolder = bank:FindFirstChild("BankCash") and bank.BankCash:FindFirstChild("Cash")
    return cashFolder and #cashFolder:GetChildren() > 0
end

local function hasRareOrPrinterOnMap()
    local entities = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Entities")
    if not entities then return false end
    local itemPickup = entities:FindFirstChild("ItemPickup")
    if not itemPickup then return false end
    for _, folder in ipairs(itemPickup:GetChildren()) do
        for _, part in ipairs(folder:GetChildren()) do
            if part:IsA("MeshPart") or part:IsA("Part") then
                local prompt = part:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.ObjectText then
                    if tableFind(rareItemNames, prompt.ObjectText)
                        or prompt.ObjectText == printerItemName then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local switching = false
local function switchServer()
    if switching then return end
    switching = true

    local requestFunc = http_request or syn.request or request
    if not requestFunc then
        switching = false
        return
    end

    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"
        local response = requestFunc({Url = url, Method = "GET"})
        if response and response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            if data and data.data and #data.data > 0 then
                local servers = data.data
                for i = #servers, 2, -1 do
                    local j = math.random(i)
                    servers[i], servers[j] = servers[j], servers[i]
                end
                for _, server in ipairs(servers) do
                    if server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or 999) then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                        return
                    end
                end
            end
        end
    end)
    switching = false
end

local busy = false
task.spawn(function()
    while true do
        task.wait(0.01)
        if busy then continue end
        if not hasBankCash() then
            if hasAnyATMAlive() then
                busy = true
                pcall(runATMPhase)
                busy = false
            end
        else
            busy = true
            pcall(tryBankHeist)
            busy = false
        end
    end
end)

task.spawn(function()
    local emptyCount = 0
    while true do
        task.wait(0.01)
        local atmsAlive   = hasAnyATMAlive()
        local bankHasCash = hasBankCash()
        local hasRare     = hasRareOrPrinterOnMap()

        if (not atmsAlive) and (not bankHasCash) and (not hasRare) then
            emptyCount = emptyCount + 1
            if emptyCount >= 100 then
                switchServer()
                task.wait(15)
                emptyCount = 0
            end
        else
            emptyCount = 0
        end
    end
end)
